# MiniMax-H3 Server Configuration -- dev/test target (1x RTX 4070, 8 GB VRAM)
# Copy to targets/dev-rtx4070/dev-rtx4070.env and edit, or export these
# before running serve.sh / install.sh.
#
# This is the single source of configuration for the dev/test target.
# A future "prod-multi-gpu" target will get its own env file under
# targets/prod-multi-gpu/ without touching this one.

# ---- model source ---------------------------------------------------
# Hugging Face repo hosting the GGUF quantizations of MiniMax-H3.
MMH3_HF_REPO=unsloth/MiniMax-H3-GGUF

# Specific GGUF artifact: lowest available quant, chosen to fit an 8 GB
# GPU (RTX 4070) with room for KV cache and context.
MMH3_GGUF_FILE=minimax_h3_fl2va_pruned-Q2_K.gguf

# Local path where the GGUF file is stored after download
# (must exist on disk, or be created by download_model.py).
# MMH3_MODEL_PATH=/home/michel/models/minimax-h3-gguf/minimax_h3_fl2va_pruned-Q2_K.gguf

# ---- server -----------------------------------------------------------
MMH3_PORT=8188
MMH3_HOST=0.0.0.0

# GPU layers offloaded to CUDA. -1 offloads as many as fit; on 8 GB VRAM
# with a Q2_K quant this is expected to be well below "all layers", so
# llama.cpp will keep the remainder on CPU RAM.
MMH3_GPU_LAYERS=-1

# Context window (tokens). Kept modest for the 8 GB dev target; increase
# once GPU/VRAM permits or when moving to the prod-multi-gpu target.
MMH3_CTX_SIZE=8192

# Max concurrent request slots.
MMH3_PARALLEL=1

# Batch sizes tuned for low VRAM.
MMH3_BATCH_SIZE=512
MMH3_UBATCH_SIZE=128

# Pre-flight only (don't start server, just check GPU/binary/model)
# MMH3_CHECK_ONLY=1
